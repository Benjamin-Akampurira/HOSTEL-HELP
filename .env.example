# Copy this file to .env and replace the placeholders with your local MySQL credentials.
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=hostel_help
MYSQL_DB_USERNAME=hostel_help_app
MYSQL_DB_PASSWORD=replace-with-your-local-mysql-password
SERVER_PORT=8081

# Optional: create the first warden account on backend startup when all are provided.
HOSTEL_WARDEN_EMAIL=
HOSTEL_WARDEN_PASSWORD=
HOSTEL_WARDEN_NAME=
HOSTEL_WARDEN_STAFF_NUMBER=
HOSTEL_WARDEN_PHONE=